# The app (npm run dev). Only VITE_* values reach the browser: never put a secret in here.
# Spotify uses PKCE, so there is no client secret anywhere.
# VITE_SPOTIFY_CLIENT_ID=
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/
# VITE_SPOTIFY_LOGO=/spotify-logo.svg

# Server only (Vercel project settings): never put these in a VITE_* variable.
# Storage, choose one. Supabase wins when both are set (run db/dashy-tasks.sql once):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   # bypasses RLS: server only, never in the browser
# or an Upstash Redis database (REST credentials; Vercel's integration names them KV_REST_API_URL / KV_REST_API_TOKEN):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Two different long random strings (at least 16 characters; `openssl rand -hex 24`):
# DASHY_MCP_TOKEN=      # for Claude's connector: can write
# DASHY_STATE_TOKEN=    # for the screen: can only read
# DASHY_ACTION_TOKEN=   # for the screen: can only check a task off or undo it

# When your working day starts and ends (Mon-Fri). Drives the day bar on the screen. Default 08:30-17:00.
# DASHY_WORKDAY=08:30-17:00
