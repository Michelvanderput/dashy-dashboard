# Server only (Vercel project settings or .env.local). Never put these in the app.
ANTHROPIC_API_KEY=
DASHY_API_TOKEN=            # long random string; the app sends it as "Authorization: Bearer <token>"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# DASHY_MODEL=claude-opus-5-5

# Remote MCP (api/mcp), the screen's read-only state (api/dashy-state) and its action endpoint (api/dashy-action). Use three different long random strings.
DASHY_MCP_TOKEN=            # for Claude (write)
DASHY_STATE_TOKEN=          # for the screen (read only)
DASHY_ACTION_TOKEN=         # for the screen (check a task off / undo, nothing else)
# Connect a device once by opening  https://<your-app>/#key=<DASHY_STATE_TOKEN>&act=<DASHY_ACTION_TOKEN>

# The app (npm run dev). Only VITE_* values reach the browser: never put a secret in here.
# VITE_SPOTIFY_CLIENT_ID=
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/
# VITE_SPOTIFY_LOGO=/spotify-logo.svg
