{
  "name": "dashy-avatar",
  "version": "0.1.0",
  "description": "Dashy: a living avatar (eyes only) and a vinyl music player with Spotify.",
  "type": "module",
  "main": "dist/dashy.js",
  "module": "dist/dashy.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && vitest run",
    "build": "esbuild src/index.ts --bundle --format=esm --minify --outfile=dist/dashy.js && esbuild src/react/index.ts --bundle --format=esm --minify --external:react --outfile=dist/react.js && esbuild src/spotify/index.ts --bundle --format=esm --minify --outfile=dist/spotify.js && tsc -p tsconfig.build.json",
    "export": "tsx scripts/export-static.ts",
    "swift:reference": "tsx scripts/swift-reference.ts",
    "swift:test": "cd swift/DashyKit && swift test",
    "dev": "vite",
    "app:build": "vite build",
    "api:dev": "tsx scripts/dev-api.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:icons": "tauri icon exports/app-icon/idle-1024.png"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.56.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dashy.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./spotify": {
      "types": "./dist/spotify/index.d.ts",
      "import": "./dist/spotify.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
