{
  "name": "dashy-avatar",
  "version": "0.1.0",
  "description": "Dashy: a living avatar (eyes only) driven by a small, dependency-free spring simulation.",
  "type": "module",
  "main": "dist/dashy.js",
  "module": "dist/dashy.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && vitest run",
    "build": "esbuild src/index.ts --bundle --format=esm --minify --outfile=dist/dashy.js && esbuild src/react/index.ts --bundle --format=esm --minify --external:react --outfile=dist/react.js && esbuild src/advice-index.ts --bundle --format=esm --minify --outfile=dist/advice.js && tsc -p tsconfig.build.json && node scripts/make-demo.mjs",
    "demo": "node scripts/make-demo.mjs",
    "export": "tsx scripts/export-static.ts",
    "swift:reference": "tsx scripts/swift-reference.ts",
    "swift:test": "cd swift/DashyKit && swift test"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.142",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^29.1.1",
    "playwright": "^1.56.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dashy.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./advice": {
      "types": "./dist/advice-index.d.ts",
      "import": "./dist/advice.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
