# The app (npm run dev). Only VITE_* values reach the browser: never put a secret in here.
# Spotify uses PKCE, so there is no client secret anywhere.
# VITE_SPOTIFY_CLIENT_ID=9965b3598c5f483fb3c6924fc90a6b05
# VITE_SPOTIFY_REDIRECT_URI=https://dashy-dashboard-eight.vercel.app/
# VITE_SPOTIFY_LOGO=/spotify-logo.svg
